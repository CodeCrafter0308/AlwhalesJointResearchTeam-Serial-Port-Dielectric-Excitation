<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DataReceiveAndAnalysisSetup</AssemblyName>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Payload\DataReceiveAndAnalysis.exe" LogicalName="DataReceiveAndAnalysis.exe" />
    <EmbeddedResource Include="Payload\app_icon.ico" LogicalName="app_icon.ico" />
  </ItemGroup>
</Project>
